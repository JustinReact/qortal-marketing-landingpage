{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && npm run copy-views && npm run copy-qortal",
    "test": "echo \"Error: no test specified\" && exit 1",
    "copy-views": "copyfiles -u 0 views/**/* dist",
    "copy-qortal": "cp -r qortal dist/",
    "watch-views": "chokidar \"views/**/*\" -c \"npm run copy-views\"",
    "watch-qortal": "chokidar \"qortal/**/*\" -c \"npm run copy-qortal\"",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "preserve": "npm run build",
    "serve": "concurrently -k \"tsc -w\" \"npm run watch-views\" \"npm run watch-qortal\" \"wait-on dist/server.js && nodemon dist/server.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.17",
    "archiver": "^7.0.1",
    "asmcrypto.js": "^2.3.2",
    "axios": "^1.18.0",
    "body-parser": "^2.2.0",
    "bs58": "^5.0.0",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.3",
    "jsonwebtoken": "^9.0.2",
    "mailersend": "^2.6.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "uuid": "^13.0.0",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/validator": "^13.15.0",
    "chokidar-cli": "^3.0.0",
    "copyfiles": "^2.4.1",
    "wait-on": "^8.0.3"
  }
}
